# Gmail API: enable Gmail API in Google Cloud and create OAuth credentials.
# Generate the refresh token with the gmail.send scope. These values must remain server-side.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Remote Agric

